      "description": "A livelier Dynasty feed, scouting fog, grades and clearer money displays."
    },
    {
      "id": "GamedayAtmosphere",
      "sourceCandidate": "2.1.9-private-update4",
      "preserveSettings": true,
      "preserveHistory": true,
      "displayName": "Gameday Atmosphere",
      "description": "Crowds that arrive, react and travel with the matchup."
    },
    {
      "id": "ExtraDynastySettings",
      "sourceCandidate": "0.2.10",
      "clockScope": "dynasty",
      "defaultOffensiveClock": "on",
      "defaultDefensiveSeconds": 15,
      "displayName": "Extra Settings",
      "description": "More offline Dynasty controls, including clocks saved for each Dynasty."
    },
    {
      "id": "DrivePractice",
      "sourceCandidate": "0.8.21",
      "defaultPracticeMode": "native",
      "displayName": "Expanded Practice",
      "description": "Practice full drives or scrimmages from the normal practice menu."
    }
