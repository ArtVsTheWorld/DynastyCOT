    "Live gameplay and save/load acceptance",
    "Exact overhaul/version compatibility acceptance"
  ],
  "liveAcceptance": "pending",
  "published": false,
  "distribution": {
    "repository": "ArtVsTheWorld/DynastyCOT",
    "visibility": "public",
    "prerelease": true,
    "compatibilityNotes": "Public test prerelease; not a stable release. Offline Dynasty only. AIO 1.4.1 + TeamBuilder patch has targeted adapters; exact game/overhaul combinations still require live acceptance. Keep a backup and an older installer. Updates are optional."
